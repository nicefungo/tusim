{
  "tu": {
    "name": "TinyTU",
    "version": "2.0-dev",

    "compute": {
      "pe_array": {
        "rows": 16,
        "cols": 16,
        "dataflow": "weight_stationary",
        "pipeline_depth": 2
      },
      "mac_units_per_pe": 1,
      "supported_precisions": ["fp16", "fp32"],
      "accumulator_precision": "fp32",
      "max_tile_rows": 0,
      "max_tile_cols": 0,
      "max_tile_inner": 0
    },

    "memory": {
      "sram": {
        "w_buffer_kb": 128,
        "a_buffer_kb": 64,
        "o_buffer_kb": 64
      },
      "banking": {
        "banks": 32,
        "bank_width_bytes": 4,
        "words_per_refill": 1,
        "refill_window_cycles": 4,
        "stall_penalty_cycles": 2,
        "conflict_model": "detect"
      },
      "latency": {
        "sram_read": 1,
        "sram_write": 1,
        "dram_read": 50,
        "dram_write": 50
      },
      "dram": {
        "type": "ideal",
        "bandwidth_gbps": 256.0,
        "channels": 8,
        "model_row_conflicts": false,
        "row_policy": "legacy",
        "address_mapping": "burst_interleaved",
        "row_miss_penalty_cycles": 10,
        "row_conflict_penalty_cycles": 0,
        "row_open_timeout_cycles": 100,
        "row_open_timeout_ns": 100.0,
        "row_timeout_domain": "core_cycles",
        "latency_domain": "core_cycles",
        "core_clock_ghz": 1.0,
        "turnaround_mode": "none",
        "turnaround_domain": "core_cycles",
        "read_to_write_turnaround": 0.0,
        "write_to_read_turnaround": 0.0,
        "read_burst_bytes": 64,
        "write_burst_bytes": 64,
        "refresh": {
          "mode": "none",
          "scheduling": "fixed",
          "rate": 1,
          "trefi_ns": 7800,
          "trfc_ns": 350,
          "trfc_pb_ns": 90,
          "max_deferral_ns": 7800
        }
      }
    },

    "dma": {
      "bus_width_bits": 256,
      "max_burst_bytes": 64,
      "channels": 3,
      "bus_topology": "independent",
      "arbitration": "round_robin",
      "max_outstanding": 4,
      "async_mode": false,
      "multicast_enabled": false
    },

    "weight_compression": {
      "enabled": false,
      "type": "none",
      "rle_epsilon": 0.0,
      "decoder_enabled": false,
      "decoder_overlap_dma": true,
      "decoder_elements_per_cycle": 1,
      "rle_runs_per_cycle": 1,
      "bitmap_elements_per_cycle": 1
    },

    "isa": {
      "instruction_width_bits": 96,
      "queue_depth": 16,
      "dependency_checking": false
    },

    "multicore": {
      "enabled": false,
      "num_cores": 1,
      "interconnect": "none",
      "switching": "legacy_hop_only",
      "contention": "ideal_parallel",
      "mesh_routing": "xy",
      "link_bytes_per_cycle": 16,
      "router_latency_cycles": 5,
      "cache_coherence": false
    },

    "performance": {
      "cycle_model": "cycle_accurate",
      "counters": {
        "enabled": true,
        "detailed_stalls": false
      },
      "tracing": {
        "enabled": false,
        "format": "none",
        "output_file": ""
      }
    },

    "power": {
      "enabled": false,
      "model": "none",
      "tech_node": "auto",
      "clock_freq_mhz": 0.0
    },

    "precision": {
      "fp16": {
        "rounding": "round_nearest_even",
        "subnormal": "flush_to_zero",
        "saturate": true
      },
      "fp32": {
        "rounding": "round_nearest_even"
      },
      "int8": {
        "quantization": "symmetric",
        "per_channel": false
      },
      "bf16": {
        "rounding": "round_nearest_even"
      }
    },

    "sparsity": {
      "enabled": false,
      "structured_2of4": false,
      "unstructured": false,
      "metadata_format": "bitmask",
      "decoder_groups_per_cycle": 1
    },

    "verification": {
      "golden_reference": "pytorch",
      "random_test_iterations": 1000,
      "error_tolerance": 1e-05
    }
  }
}
